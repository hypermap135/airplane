SHOPIFY_STORE_DOMAIN=y823wg-nz.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
SHOPIFY_API_VERSION=2024-07

# Optional. Domain that serves Shopify cart/checkout pages.
# Defaults to SHOPIFY_STORE_DOMAIN. Override only if Shopify serves a custom
# subdomain (e.g. shop.airplanestore.fr). DO NOT set to the Next.js site
# domain (airplanestore.fr) — Vercel doesn't serve Shopify cart paths and
# the redirect will land on a 404.
# SHOPIFY_PUBLIC_DOMAIN=shop.airplanestore.fr
