SHOPIFY_STORE_DOMAIN=y823wg-nz.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
SHOPIFY_API_VERSION=2024-07

# Optional Shopify cart domain override
# SHOPIFY_PUBLIC_DOMAIN=shop.airplanestore.fr

# ─── Meta (Facebook) Pixel + Conversions API ──────────────────────────────
# Get these from https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional QA mode: META_TEST_EVENT_CODE=TEST12345

# ─── /admin dashboard ─────────────────────────────────────────────────────
# Single shared password for the shopkeeper. Change at will.
ADMIN_PASSWORD=

# HMAC secret for the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Vercel Blob (overrides storage + photo uploads) ──────────────────────
# Create a Blob store in the Vercel dashboard (Storage tab, free tier).
# Vercel will inject this token automatically once the store is linked.
BLOB_READ_WRITE_TOKEN=
